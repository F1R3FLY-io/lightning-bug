@startuml
' How a LanguageConfig resolves its resources when a document of that language
' is activated. Colour legend (see docs/README.md):
'   Blue   = <Editor> props (languages map)
'   Purple = Tree-Sitter / WASM / syntax
'   Green  = LSP subsystem
'   Teal   = Editor runtime
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  DiamondBackgroundColor #FFF3CD
  ArrowColor #333333
}
start
:languages map (Editor prop)\nkey -> LanguageConfig;
:activate a document\nof language L; <<#4A90D9>>

partition "Grammar / parser" {
  if (config has :parser?) then (yes)
    :use custom Parser\n(bypasses grammarWasm); <<#9B59B6>>
  elseif (config has :grammar-wasm?) then (yes)
    :resolve grammarWasm\n(string OR thunk -> path/data-URL); <<#9B59B6>>
    :load Tree-Sitter grammar WASM\ninto the syntax compartment; <<#9B59B6>>
  else (neither)
    :no grammar ->\nplain-text editing\n(the default "text" language); <<#E8E8E8>>
  endif
}

partition "Syntax queries" {
  :resolve highlightsQuery /\nhighlightsQueryPath (string or thunk); <<#9B59B6>>
  :resolve indentsQuery /\nindentsQueryPath (string or thunk); <<#9B59B6>>
}

partition "Language server (optional)" {
  if (config has :lsp-url?) then (yes)
    :connect one WebSocket\nper language per Workspace; <<#27AE60>>
    :diagnostics + symbols\nlight up; <<#27AE60>>
  else (no)
    :editor degrades gracefully\n(no diagnostics/symbols); <<#E8E8E8>>
  endif
}

:editor ready for language L; <<#2AA198>>
stop
@enduml
