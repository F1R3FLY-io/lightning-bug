@startuml
' How a LanguageConfig resolves its resources when a document of that language
' is activated. Colour legend (see docs/README.md):
'   Blue   = <Editor> props (languages map)
'   Purple = Tree-Sitter / WASM / syntax
'   Green  = LSP subsystem
'   Teal   = Editor runtime
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #333333
  DiamondBackgroundColor #FFF3CD
  ArrowColor #333333
}
start
:languages map (Editor prop)\nkey -> LanguageConfig;
#4A90D9:activate a document\nof language L;

partition "Grammar / parser" {
  if (config has :parser?) then (yes)
    #9B59B6:use custom Parser\n(bypasses grammarWasm);
  elseif (config has :grammar-wasm?) then (yes)
    #9B59B6:resolve grammarWasm\n(string OR thunk -> path/data-URL);
    #9B59B6:load Tree-Sitter grammar WASM\ninto the syntax compartment;
  else (neither)
    #E8E8E8:no grammar ->\nplain-text editing\n(the default "text" language);
  endif
}

partition "Syntax queries" {
  #9B59B6:resolve highlightsQuery /\nhighlightsQueryPath (string or thunk);
  #9B59B6:resolve indentsQuery /\nindentsQueryPath (string or thunk);
}

partition "Language server (optional)" {
  if (config has :lsp-url?) then (yes)
    #27AE60:connect one WebSocket\nper language per Workspace;
    #27AE60:diagnostics + symbols\nlight up;
  else (no)
    #E8E8E8:editor degrades gracefully\n(no diagnostics/symbols);
  endif
}

#2AA198:editor ready for language L;
stop
@enduml
